# Copy to .env and adjust for local development. Do not commit .env.
#
# These DSNs use localhost, matching the docker-compose port mappings
# (db -> 5433, redis -> 6380), for running the app/tests/alembic directly
# on the host via `uv run ...`. When the `app` service itself runs inside
# docker-compose, docker-compose.yml overrides these three to use the
# compose network's internal hostnames instead.

ENV=dev
DEBUG=true
LOG_LEVEL=INFO

# Generate a real secret for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-only-placeholder-secret-change-me

# Admin/migration role: owns the schema, runs Alembic. Must never be used
# for application queries (see README: "Database roles and RLS").
DATABASE_URL=postgresql+asyncpg://docflow:docflow@localhost:5433/docflow

# Application runtime role: restricted, non-superuser, NOBYPASSRLS. This
# is what actually enforces tenant isolation. Created by the initial
# Alembic migration; the password below is a dev-only placeholder (see
# README before using this pattern anywhere near production).
APP_DATABASE_URL=postgresql+asyncpg://docflow_app:docflow_app_dev_only@localhost:5433/docflow

REDIS_URL=redis://localhost:6380/0

# "synthetic" for local/dev/test. "real" is gated behind BAA'd vendors in
# later phases and must never be used with ENV=prod until that is enforced.
PHI_MODE=synthetic

# Distinct from SECRET_KEY — see app/config.py. Generate a real one for
# anything beyond local dev, same as SECRET_KEY above.
JWT_SECRET=dev-only-placeholder-jwt-secret-change-me
JWT_ALGORITHM=HS256

# Session timeout = ACCESS_TOKEN_TTL_MINUTES (per-request token lifetime)
# + IDLE_TIMEOUT_MINUTES (refresh refused once the client's been quiet
# this long). REFRESH_TOKEN_TTL_DAYS is the hard outer ceiling.
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
IDLE_TIMEOUT_MINUTES=30

# Comma-separated origin lists — never "*". Extension origins use the
# chrome-extension://<id> scheme.
CORS_WEB_ORIGINS=http://localhost:3000
CORS_EXTENSION_ORIGINS=

# Transcription vendor — see app/transcription/factory.py. "mock" needs
# no key and is forced regardless of this setting whenever
# PHI_MODE=synthetic (real vendors only ever handle real, BAA-covered
# audio). ENV=prod refuses to start with vendor="mock".
TRANSCRIBER_VENDOR=mock

# Only required when TRANSCRIBER_VENDOR=openai. Real (non-synthetic)
# audio must not be sent to OpenAI without a signed BAA *and* a Zero Data
# Retention agreement in place first — see app/transcription/factory.py.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
TRANSCRIBE_TIMEOUT_SECONDS=30
TRANSCRIBE_MAX_RETRIES=2

# Audio ingestion (Phase 5) — see app/api/sessions.py and
# app/services/transcription_service.py.
MAX_SESSION_SECONDS=3600
MAX_AUDIO_BYTES=104857600
WS_BUFFER_MAX_CHUNKS=50

# Governs Transcript.is_retained when no session-scoped retention Consent
# exists. "none": never retain. "consented": retain only with an explicit
# granted consent on file (default). "always": retain unconditionally.
TRANSCRIPT_RETENTION_DEFAULT=consented

# SOAP note generation (Phase 6) — see app/notes/factory.py. Same rules
# as TRANSCRIBER_VENDOR: "mock" needs no key and is forced regardless of
# this setting whenever PHI_MODE=synthetic; ENV=prod refuses vendor="mock".
NOTE_GENERATOR_VENDOR=mock

# Only required when NOTE_GENERATOR_VENDOR=openai. Same BAA + Zero Data
# Retention prerequisite as OPENAI_API_KEY's use for transcription — see
# app/notes/factory.py. Reuses OPENAI_API_KEY above; the model is separate
# since transcription and note generation have different needs.
OPENAI_NOTE_MODEL=gpt-4o
NOTE_MAX_RETRIES=2
NOTE_TIMEOUT_SECONDS=30

# Conservative heuristic pre-step that strips non-clinical chatter before
# the transcript reaches the note generator — see app/notes/scrub.py.
NOTE_SCRUB_ENABLED=true

# Tag persisted on every generated Note — see
# app/notes/prompts/soap_primary_care_v1.py.
NOTE_PROMPT_VERSION=soap_primary_care_v1

# LLM tracing for note generation — off by default. If enabled,
# LANGFUSE_HOST must point at a SELF-HOSTED Langfuse instance; Langfuse
# Cloud is refused at startup (see app/config.py) because it would mean
# transcript/note PHI leaving this process.
NOTE_TRACING_ENABLED=false
LANGFUSE_HOST=

# HIPAA controls (Phase 7) — see app/security/. "local" needs no AWS and
# is the only provider the test suite exercises; ENV=prod refuses to
# start with KEY_PROVIDER=local (see app/security/keys.py). Generate a
# real per-deployment key the same way as SECRET_KEY/JWT_SECRET above,
# e.g.: python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
KEY_PROVIDER=local
LOCAL_ENCRYPTION_KEY=TlGtLjbjLbojhmM71ihT1kx4TUJaVXUARSqQqA9gwBY=
KMS_KEY_ID=
ENCRYPTION_KEY_VERSION=1

# TLS enforcement (app/security/transport.py) — default True; turned off
# here for local HTTP development. TRUST_PROXY_HEADERS=true only when
# actually deployed behind a TLS-terminating load balancer that strips
# any client-supplied X-Forwarded-Proto before setting its own.
ENFORCE_TLS=false
TRUST_PROXY_HEADERS=false

# Consent gate (app/security/consent.py). Leave false unless this
# practice has a signed blanket retention agreement backing
# TRANSCRIPT_RETENTION_DEFAULT=always — see that module's docstring for
# the risk this bypasses.
ALLOW_BLANKET_RETENTION=false

# --- Phase 8: hardening and operations -------------------------------

# Central Redis-backed rate limiter — see app/ops/ratelimit.py. Defaults
# below are lenient on purpose; tighten per-bucket for a real deployment.
RATELIMIT_ENABLED=true
RATELIMIT_LOGIN_LIMIT=10
RATELIMIT_LOGIN_WINDOW_SECONDS=60
RATELIMIT_REFRESH_LIMIT=20
RATELIMIT_REFRESH_WINDOW_SECONDS=60
RATELIMIT_SESSION_CREATE_LIMIT=30
RATELIMIT_SESSION_CREATE_WINDOW_SECONDS=60
RATELIMIT_NOTE_GENERATE_LIMIT=20
RATELIMIT_NOTE_GENERATE_WINDOW_SECONDS=60
RATELIMIT_WS_CONNECT_LIMIT=10
RATELIMIT_WS_CONNECT_WINDOW_SECONDS=60
RATELIMIT_READ_LIMIT=300
RATELIMIT_READ_WINDOW_SECONDS=60

# GET /metrics (app/api/metrics.py) — a Prometheus scrape target, not a
# public endpoint. Leave METRICS_AUTH_TOKEN unset only if network policy
# (an internal-only ingress/firewall rule) already keeps this off the
# public internet — see README's "Metrics" section.
METRICS_ENABLED=true
METRICS_AUTH_TOKEN=

# LLM tracing reuses NOTE_TRACING_ENABLED/LANGFUSE_HOST above (Phase 6);
# these are the credentials for that same self-hosted instance.
# TRACE_INCLUDE_CONTENT attaches transcript/note TEXT (not just metadata)
# to a trace — refused at startup under PHI_MODE=real or ENV=prod (see
# app/config.py and app/security/startup_checks.py); leave false unless
# actively debugging prompt behavior against synthetic data.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
TRACE_INCLUDE_CONTENT=false

# Celery broker/result backend (app/worker/celery_app.py) — left unset
# here on purpose: app/config.py's _default_celery_urls derives both from
# REDIS_URL (separate logical DBs 1 and 2) so a bare checkout needs no
# extra config. Override only for a dedicated broker/backend.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Retention-purge job (app/worker/tasks.py, scheduled by Celery beat on
# PURGE_INTERVAL) — durations are "<int><s|m|h|d>" (see
# app/ops/durations.py). PURGE_DRY_RUN=true logs what WOULD be deleted
# without deleting; flip to false only after reviewing dry-run output.
PURGE_UNRETAINED_AFTER=24h
PURGE_ORPHAN_SESSION_AFTER=24h
PURGE_INTERVAL=1h
PURGE_DRY_RUN=true
